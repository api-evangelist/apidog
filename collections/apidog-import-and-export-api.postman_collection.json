        {
          "id": "6d200177-8d0c-44a7-ad33-5ce67aef3adc",
          "name": "Export Data In OpenAPI Or Swagger Format",
          "request": {
            "name": "Export Data In OpenAPI Or Swagger Format",
            "description": {
              "content": "Export the API specification data from the specified Apidog project in OpenAPI 2.0, 3.0, or 3.1 format. Output is delivered as a fully-formed OpenAPI document containing info, paths, components, tags, and servers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "projects",
                ":projectId",
                "export-openapi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "projectId",
                  "description": "(Required) The unique identifier of the Apidog project."
